// Cloudflare Workers config.
// - Static site: served from ./dist (the Astro build).
// - /api/* requests run worker/index.js, which saves newsletter signups to D1.
// "name" must match the Worker's name in the Cloudflare dashboard.
{
  "name": "vibe-coded-site",
  "main": "worker/index.js",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "vibe-coded-site-subscribers"
    }
  ]
}
