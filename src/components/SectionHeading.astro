---
// Small label + big Khand heading. `highlight` is appended in red.
interface Props {
  eyebrow?: string;
  title: string;
  highlight?: string;
  as?: 'h1' | 'h2';
  id?: string;
}

const { eyebrow, title, highlight, as: Tag = 'h2', id } = Astro.props;
---

<div class="section-heading">
  {eyebrow && <p class="eyebrow">{eyebrow}</p>}
  <Tag id={id} class:list={[Tag === 'h1' ? 'size-lg' : 'size-md']}>
    {title}{highlight && ' '}
    {highlight && <span class="highlight">{highlight}</span>}
  </Tag>
</div>

<style>
  .section-heading {
    display: grid;
    gap: var(--space-3);
    margin-bottom: var(--space-6);
  }

  .size-lg {
    font-size: var(--display-lg);
  }

  .size-md {
    font-size: var(--display-md);
  }
</style>
